# Proxy (optional). Empty = direct mode.
# If set and multiple categories, parser uses sticky ports: base:10000, +1 per category.
LENTA_PROXY=""
# LENTA_PROXY="http://user:pass@host:port"

# Concurrency: max parallel category workers.
LENTA_SCAN_CONCURRENCY=3

# Parser tuning.
LENTA_PAGE_LIMIT=40
LENTA_MAX_PAGES=0
LENTA_DELAY_MIN_MS=1200
LENTA_DELAY_MAX_MS=3400
